<Window x:Class="FinderWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Finder" Icon="/Assets/FinderWin.ico" Width="1240" Height="790" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="./Assets/Fonts/#Source Han Sans SC"
        PreviewKeyDown="Window_KeyDown" SourceInitialized="Window_SourceInitialized">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="72" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="dot" Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#00000020" BorderThickness="1"><Viewbox Width="8" Height="8"><Grid x:Name="symbols" Opacity="0"><Path x:Name="closeSymbol" Data="M1,1 L7,7 M7,1 L1,7" Stroke="#90000000" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/><Path x:Name="minSymbol" Data="M1,4 L7,4" Stroke="#90000000" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/><Path x:Name="zoomSymbol" Data="M4,1 L4,7 M1,4 L7,4" Stroke="#90000000" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Grid></Viewbox></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="Opacity" Value=".84"/><Setter TargetName="symbols" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="dot" Property="Opacity" Value=".62"/></Trigger><Trigger Property="Tag" Value="Close"><Setter TargetName="closeSymbol" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Tag" Value="Minimize"><Setter TargetName="minSymbol" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Tag" Value="Zoom"><Setter TargetName="zoomSymbol" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="hit" Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hit" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="hit" Property="Opacity" Value=".68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="hit" Property="Opacity" Value=".28"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SidebarItem" TargetType="RadioButton"><Setter Property="Height" Value="31"/><Setter Property="Margin" Value="5,1"/><Setter Property="Padding" Value="9,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="selection" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="selection" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="selection" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="FileRowItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="12,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Cursor" Value="Arrow"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" CornerRadius="7" SnapsToDevicePixels="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource ToolbarBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="7"/><Setter Property="HasDropShadow" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/><Setter Property="MinWidth" Value="220"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="item" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="›" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" x:Name="arrow"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="HasItems" Value="True"><Setter TargetName="arrow" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Separator"><Setter Property="Margin" Value="10,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource StrokeBrush}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="IconItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="WindowShell" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" CornerRadius="15,15,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource ChromeButton}" Click="Close_Click" Background="#FF5F57" Tag="Close" ToolTip="关闭"/><Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" Background="#FEBC2E" Tag="Minimize" ToolTip="最小化"/><Button Style="{StaticResource ChromeButton}" Click="Zoom_Click" Background="#28C840" Tag="Zoom" ToolTip="全屏 / 还原"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Border Background="{DynamicResource HoverBrush}" CornerRadius="22" Padding="5,1"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ToolButton}" Click="Back_Click" ToolTip="后退">&#xE72B;</Button><Border Width="1" Height="19" Background="{DynamicResource StrokeBrush}" VerticalAlignment="Center"/><Button Style="{StaticResource ToolButton}" Click="Forward_Click" ToolTip="前进">&#xE72A;</Button></StackPanel></Border></StackPanel>
        <Grid Grid.Column="2" Margin="22,0,12,0" ClipToBounds="True"><TextBlock Text="{Binding FolderTitle}" ToolTip="{Binding FolderTitle}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource ToolButton}" Click="ChangeView_Click" ToolTip="切换图标 / 列表视图">&#xE8A9;</Button><Button Style="{StaticResource ToolButton}" Click="Sort_Click" ToolTip="排序">&#xE8CB;</Button>
          <Button x:Name="ShareButton" Style="{StaticResource ToolButton}" Click="Share_Click" ToolTip="分享" IsEnabled="False">&#xE72D;</Button><Button x:Name="TagButton" Style="{StaticResource ToolButton}" Click="Tag_Click" ToolTip="标签" IsEnabled="False">&#xE8EC;</Button><Button Style="{StaticResource ToolButton}" Click="More_Click" ToolTip="更多">&#xE712;</Button>
          <Border x:Name="SearchHost" Background="{DynamicResource HoverBrush}" CornerRadius="18" Width="38" Height="34" Margin="8,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource ToolButton}" Click="SearchToggle_Click" ToolTip="搜索">&#xE721;</Button><TextBox Grid.Column="1" x:Name="SearchBox" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center" FontSize="12" TextChanged="Search_TextChanged" KeyDown="SearchBox_KeyDown" ToolTip="搜索"/><Button Grid.Column="2" x:Name="SearchClearButton" Style="{StaticResource ToolButton}" Width="28" Visibility="Collapsed" Click="SearchClear_Click" ToolTip="清除">&#xE711;</Button></Grid></Border>
        </StackPanel>
      </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,1,0" Padding="7,10,7,8">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Recent_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE823;"/><TextBlock Grid.Column="1" Text="最近使用"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Shared_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE8FA;"/><TextBlock Grid.Column="1" Text="共享"/></Grid></RadioButton>
            <TextBlock Text="个人收藏" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,17,0,5"/>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Applications_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE74C;"/><TextBlock Grid.Column="1" Text="应用程序"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Documents_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE8A5;"/><TextBlock Grid.Column="1" Text="文稿"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Desktop_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE7F4;"/><TextBlock Grid.Column="1" Text="桌面"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Pictures_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE8B9;"/><TextBlock Grid.Column="1" Text="图片"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Movies_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE8B2;"/><TextBlock Grid.Column="1" Text="影片"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="Downloads_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE896;"/><TextBlock Grid.Column="1" Text="Downloads"/></Grid></RadioButton>
            <TextBlock Text="位置" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,17,0,5"/>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" IsChecked="True" Click="Home_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE80F;"/><TextBlock Grid.Column="1" Text="个人文件夹"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="ICloud_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE753;"/><TextBlock Grid.Column="1" Text="iCloud 云盘"/></Grid></RadioButton>
            <RadioButton Style="{StaticResource SidebarItem}" GroupName="Sidebar" Click="ChooseFolder_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE838;"/><TextBlock Grid.Column="1" Text="打开文件夹…"/></Grid></RadioButton>
            <TextBlock Text="标签" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,17,0,5"/>
            <StackPanel x:Name="TagsSidebarPanel"/>
          </StackPanel></ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Background="{DynamicResource ContentBrush}"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="1"/><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding CurrentPath}" Margin="21,9,18,4" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
          <Border Grid.Row="1" Background="{DynamicResource StrokeBrush}"/>
          <Grid x:Name="ColumnsHeader" Grid.Row="2" Margin="21,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/><ColumnDefinition Width="100"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="名称    ⌃" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/><Border Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="12,0"><TextBlock Text="修改日期" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></Border><Border Grid.Column="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="12,0"><TextBlock Text="大小" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></Border><Border Grid.Column="3" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0" Padding="12,0"><TextBlock Text="种类" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></Border></Grid>
          <ListBox Grid.Row="3" x:Name="FileList" ItemsSource="{Binding FilesView}" SelectionMode="Extended" SelectionChanged="FileSelection_Changed" ItemContainerStyle="{StaticResource FileRowItem}" BorderThickness="0" Background="Transparent" MouseDoubleClick="FileList_DoubleClick" ContextMenuOpening="FileList_ContextMenuOpening" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><Grid Height="32" Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/><ColumnDefinition Width="100"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="29"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Disclosure" Grid.Column="0" Text="›" Width="17" FontSize="21" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/><Grid Grid.Column="1" Width="29" Height="25" VerticalAlignment="Center">
                <Image x:Name="FolderGlyph" Source="/Assets/FolderFilled.png" Stretch="Uniform" Width="28" Height="25"/>
                <Image x:Name="EmptyFolderGlyph" Source="/Assets/FolderEmpty.png" Stretch="Uniform" Width="28" Height="25" Visibility="Collapsed"/>
                <Grid x:Name="FileGlyph" Visibility="Collapsed">
                  <Grid x:Name="GenericGlyph"><Image Source="/Assets/GenericFile.png" Stretch="Uniform" Width="20" Height="25"/><TextBlock Text="{Binding ExtensionLabel}" FontSize="4.6" Foreground="#A8A8AA" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Grid>
                  <Image x:Name="ZipGlyph" Source="/Assets/Zip.png" Stretch="Uniform" Width="20" Height="25" Visibility="Collapsed"/>
                </Grid>
              </Grid><Border x:Name="ListTagDot" Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{Binding TagColor}" Margin="5,0,5,0" Visibility="Collapsed"/><TextBlock Grid.Column="3" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
              <TextBlock x:Name="ModifiedText" Grid.Column="1" Text="{Binding Modified, StringFormat={}{0:yyyy/M/d HH:mm}}" Margin="12,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="SizeValueText" Grid.Column="2" Text="{Binding SizeText}" Margin="12,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock x:Name="KindText" Grid.Column="3" Text="{Binding Kind}" Margin="12,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding HasTag}" Value="True"><Setter TargetName="ListTagDot" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsDirectory}" Value="False"><Setter TargetName="Disclosure" Property="Visibility" Value="Hidden"/><Setter TargetName="FolderGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="FileGlyph" Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsDirectory}" Value="True"/><Condition Binding="{Binding HasChildren}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="Disclosure" Property="Opacity" Value=".35"/><Setter TargetName="FolderGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="EmptyFolderGlyph" Property="Visibility" Value="Visible"/></MultiDataTrigger><DataTrigger Binding="{Binding IsArchive}" Value="True"><Setter TargetName="GenericGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="ZipGlyph" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Disclosure" Property="Foreground" Value="White"/><Setter TargetName="ModifiedText" Property="Foreground" Value="White"/><Setter TargetName="SizeValueText" Property="Foreground" Value="White"/><Setter TargetName="KindText" Property="Foreground" Value="White"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ContextMenu><ContextMenu><MenuItem Header="新建文件夹" Click="NewFolder_Click"/><Separator/><MenuItem Header="打开" Click="Open_Click"/><MenuItem Header="快速查看" Click="QuickLook_Click"/><MenuItem Header="显示简介" Click="GetInfo_Click"/><Separator/><MenuItem Header="重命名" Click="Rename_Click"/><MenuItem Header="制作副本" Click="Duplicate_Click"/><Separator/><MenuItem Header="复制" Click="Copy_Click"/><MenuItem Header="剪切" Click="Cut_Click"/><MenuItem Header="粘贴项目" Click="Paste_Click"/><Separator/><MenuItem Header="移到废纸篓" Click="Trash_Click"/><Separator/><MenuItem Header="压缩" Click="Compress_Click"/><MenuItem Header="解压缩" Click="Extract_Click"/><Separator/><MenuItem Header="显示/隐藏隐藏项目" Click="ToggleHidden_Click"/></ContextMenu></ListBox.ContextMenu>
          </ListBox>
          <ListBox Grid.Row="3" x:Name="IconList" ItemsSource="{Binding FilesView}" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="FileSelection_Changed" BorderThickness="0" Background="Transparent" AllowDrop="True" PreviewMouseLeftButtonDown="IconList_MouseLeftDown" PreviewMouseLeftButtonUp="IconList_MouseLeftUp" PreviewMouseMove="IconList_PreviewMouseMove" Drop="IconList_Drop" MouseDoubleClick="IconList_DoubleClick" ScrollViewer.CanContentScroll="False"><ListBox.ItemContainerStyle><Style BasedOn="{StaticResource IconItem}" TargetType="ListBoxItem"><Setter Property="Canvas.Left" Value="{Binding CanvasX}"/><Setter Property="Canvas.Top" Value="{Binding CanvasY}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><Canvas MinWidth="1000" MinHeight="700"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="112" Height="126" Margin="9" HorizontalAlignment="Center"><Border x:Name="IconBack" Height="88" CornerRadius="13" Padding="6"><Grid><Image x:Name="IconFolder" Source="/Assets/FolderFilled.png" Stretch="Uniform"/><Image x:Name="IconEmpty" Source="/Assets/FolderEmpty.png" Stretch="Uniform" Visibility="Collapsed"/><Grid x:Name="IconGeneric" Visibility="Collapsed"><Image Source="/Assets/GenericFile.png" Stretch="Uniform"/><TextBlock Text="{Binding ExtensionLabel}" FontSize="{Binding ExtensionLabelFontSize}" Foreground="#A8A8AA" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid><Image x:Name="IconZip" Source="/Assets/Zip.png" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><Border x:Name="NameBadge" CornerRadius="5" HorizontalAlignment="Center" Padding="3,1" MaxWidth="112"><StackPanel Orientation="Horizontal"><Border x:Name="IconTagDot" Width="8" Height="8" CornerRadius="4" Background="{Binding TagColor}" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" MaxWidth="96" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></Border></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding HasTag}" Value="True"><Setter TargetName="IconTagDot" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="IconBack" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter TargetName="NameBadge" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="NameBadge" Property="TextElement.Foreground" Value="White"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsDirectory}" Value="True"/><Condition Binding="{Binding HasChildren}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="IconFolder" Property="Visibility" Value="Collapsed"/><Setter TargetName="IconEmpty" Property="Visibility" Value="Visible"/></MultiDataTrigger><DataTrigger Binding="{Binding IsDirectory}" Value="False"><Setter TargetName="IconFolder" Property="Visibility" Value="Collapsed"/><Setter TargetName="IconGeneric" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsArchive}" Value="True"><Setter TargetName="IconGeneric" Property="Visibility" Value="Collapsed"/><Setter TargetName="IconZip" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="新建文件夹" Click="NewFolder_Click"/><Separator/><MenuItem Header="打开" Click="Open_Click"/><MenuItem Header="快速查看" Click="QuickLook_Click"/><MenuItem Header="显示简介" Click="GetInfo_Click"/><Separator/><MenuItem Header="重命名" Click="Rename_Click"/><MenuItem Header="制作副本" Click="Duplicate_Click"/><Separator/><MenuItem Header="复制" Click="Copy_Click"/><MenuItem Header="剪切" Click="Cut_Click"/><MenuItem Header="粘贴项目" Click="Paste_Click"/><Separator/><MenuItem Header="移到废纸篓" Click="Trash_Click"/><Separator/><MenuItem Header="压缩" Click="Compress_Click"/><MenuItem Header="解压缩" Click="Extract_Click"/><Separator/><MenuItem Header="显示/隐藏隐藏项目" Click="ToggleHidden_Click"/></ContextMenu></ListBox.ContextMenu></ListBox>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="20,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock DockPanel.Dock="Right" Text="按 Win + Shift + . 显示隐藏项目" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/></DockPanel></Border>
    </Grid>
  </Border>
</Window>
