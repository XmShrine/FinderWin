<Application x:Class="FinderWin.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#F5F5F6"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#ECECEE"/>
    <SolidColorBrush x:Key="ContentBrush" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#D2D2D4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7C7C80"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E3E3E6"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="SidebarOutlineBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#887A7A7E"/>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" ClipToBounds="False"><Border Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6" Margin="1"/><Track x:Name="PART_Track" Margin="3,2" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Opacity=".78"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" ClipToBounds="False"><Border Background="{DynamicResource ScrollTrackBrush}" CornerRadius="6" Margin="1"/><Track x:Name="PART_Track" Margin="2,3" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinWidth="32"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Opacity=".78"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
