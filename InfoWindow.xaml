<Window x:Class="FinderWin.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="简介" Icon="/Assets/FinderWin.ico" Width="470" Height="720" MinWidth="420" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" FontFamily="./Assets/Fonts/#Source Han Sans SC">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Traffic" TargetType="Button"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="dot" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#22000000" BorderThickness="1"><Viewbox x:Name="glyph" Width="8" Height="8" Opacity="0"><Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="#90000000" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="glyph" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Expander"><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="13,9"><DockPanel><TextBlock x:Name="arrow" Text="›" FontSize="20" Width="19" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="arrow" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Border x:Name="ExpandSite" Visibility="Collapsed" Padding="34,4,18,14"><ContentPresenter/></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,2"/></Style>
  </Window.Resources>
  <Border x:Name="WindowShell" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button Style="{StaticResource Traffic}" Background="#FF5F57" Click="Close_Click"/><Border Width="16" Height="16" CornerRadius="9" Background="#FEBC2E" BorderBrush="#22000000" BorderThickness="1" Margin="0,0,9,0"/><Border Width="16" Height="16" CornerRadius="9" Background="#28C840" BorderBrush="#22000000" BorderThickness="1"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding InfoTitle}" ToolTip="{Binding InfoTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid Margin="22,20,22,15"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="55" Height="58" HorizontalAlignment="Left"><Image x:Name="FolderPreview" Source="/Assets/FolderFilled.png" Stretch="Uniform"/><Grid x:Name="GenericPreview" Visibility="Collapsed"><Image Source="/Assets/GenericFile.png" Stretch="Uniform"/><TextBlock Text="{Binding ExtensionLabel}" FontSize="8" Foreground="#A8A8AA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/></Grid><Image x:Name="ZipPreview" Source="/Assets/Zip.png" Stretch="Uniform" Visibility="Collapsed"/></Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Modified, StringFormat=修改时间：{0:yyyy年M月d日 HH:mm}}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Top"/>
          </Grid>
          <Border Margin="16,0,16,8" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7"><TextBlock Text="添加标签…" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/></Border>
          <Expander Header="通用：" IsExpanded="True"><StackPanel><TextBlock Style="{StaticResource SectionText}" Text="{Binding Kind, StringFormat=种类：{0}}"/><TextBlock Style="{StaticResource SectionText}" Text="{Binding SizeText, StringFormat=大小：{0}}"/><TextBlock Style="{StaticResource SectionText}" Text="{Binding FullPath, StringFormat=位置：{0}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource SectionText}" Text="{Binding Created, StringFormat=创建时间：{0:yyyy年M月d日 HH:mm}}"/><TextBlock Style="{StaticResource SectionText}" Text="{Binding Modified, StringFormat=修改时间：{0:yyyy年M月d日 HH:mm}}"/><CheckBox Content="样版" Margin="15,10,0,2" IsEnabled="False"/><CheckBox Content="已锁定" Margin="15,2,0,0" IsEnabled="False"/></StackPanel></Expander>
          <Expander Header="更多信息："><TextBlock Text="--" Foreground="{DynamicResource SecondaryTextBrush}"/></Expander>
          <Expander Header="名称与扩展名：" IsExpanded="True"><StackPanel><TextBox Text="{Binding ItemName, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="8,6"/><CheckBox Content="隐藏扩展名" Margin="5,9,0,0" IsEnabled="False"/></StackPanel></Expander>
          <Expander Header="注释："><TextBox MinHeight="65" TextWrapping="Wrap" Background="{DynamicResource ContentBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource StrokeBrush}"/></Expander>
          <Expander Header="打开方式：" IsExpanded="True"><StackPanel><Border Background="{DynamicResource HoverBrush}" CornerRadius="7" Padding="9"><TextBlock Text="Windows 默认应用程序"/></Border><TextBlock Text="使用此应用程序打开所有这种类型的文稿。" FontSize="11" Margin="0,8,0,0"/></StackPanel></Expander>
          <Expander Header="预览：" IsExpanded="True"><Grid Height="175"><Grid Width="130" Height="145"><Image x:Name="LargeFolderPreview" Source="/Assets/FolderFilled.png" Stretch="Uniform"/><Grid x:Name="LargeGenericPreview" Visibility="Collapsed"><Image Source="/Assets/GenericFile.png" Stretch="Uniform"/><TextBlock Text="{Binding ExtensionLabel}" FontSize="18" Foreground="#A8A8AA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/></Grid><Image x:Name="LargeZipPreview" Source="/Assets/Zip.png" Stretch="Uniform" Visibility="Collapsed"/></Grid></Grid></Expander>
          <Expander Header="共享与权限：" IsExpanded="True"><StackPanel><TextBlock Text="你可以读与写" Margin="0,0,0,10"/><Grid Background="{DynamicResource HoverBrush}" Margin="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="名称" FontWeight="SemiBold" Margin="8,5"/><TextBlock Grid.Column="1" Text="权限" FontWeight="SemiBold" Margin="8,5"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="当前用户（本用户）" Margin="8,5"/><TextBlock Grid.Column="1" Text="读与写" Margin="8,5"/></Grid><Grid Background="{DynamicResource HoverBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="Administrators" Margin="8,5"/><TextBlock Grid.Column="1" Text="读与写" Margin="8,5"/></Grid></StackPanel></Expander>
          <Border Height="18"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
